pkgname=praefectus-native
pkgver=0.1.0
pkgrel=1
pkgdesc='Native Qt backup and selective restore client for Proton Drive'
arch=('x86_64')
url='https://github.com/jcergolj/praefectus-castri-posterioris'
license=('MIT')
depends=('qt6-base' 'qt6-declarative')
makedepends=('cmake')
optdepends=('proton-drive: Proton Drive CLI used for backup storage')
source=()
sha256sums=()

build() {
    cmake -S "$startdir/../../native" -B "$srcdir/build" \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr
    cmake --build "$srcdir/build" --target praefectus-native praefectus-native-worker
}

package() {
    install -Dm755 "$srcdir/build/praefectus-native" "$pkgdir/usr/bin/praefectus-native"
    install -Dm755 "$srcdir/build/praefectus-native-worker" "$pkgdir/usr/bin/praefectus-native-worker"
    install -Dm644 "$startdir/praefectus-native.desktop" "$pkgdir/usr/share/applications/praefectus-native.desktop"
    install -Dm644 "$startdir/praefectus-native.service" "$pkgdir/usr/lib/systemd/user/praefectus-native.service"
    install -Dm644 "$startdir/praefectus-native.timer" "$pkgdir/usr/lib/systemd/user/praefectus-native.timer"
}
