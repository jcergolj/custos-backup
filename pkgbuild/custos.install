post_install() {
    update-desktop-database -q >/dev/null 2>&1 || true
    gtk-update-icon-cache -q -t -f usr/share/icons/hicolor >/dev/null 2>&1 || true
    printf '%s\n' 'Custos Backup installed. Authenticate proton-drive, configure a backup, then run:'
    printf '%s\n' '  systemctl --user enable --now custos.timer'
}

post_upgrade() {
    post_install
}

post_remove() {
    update-desktop-database -q >/dev/null 2>&1 || true
    gtk-update-icon-cache -q -t -f usr/share/icons/hicolor >/dev/null 2>&1 || true
}
