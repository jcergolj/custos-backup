# Maintainer: Custos contributors

pkgname=custos-git
pkgver=0.1.r42.g329cbc4
pkgrel=1
pkgdesc='Custos Backup client for Proton Drive'
arch=('x86_64')
url='https://github.com/jcergolj/custos-backup'
license=('MIT')
depends=('qt6-base' 'qt6-declarative')
makedepends=('cmake' 'gcc')
optdepends=('proton-drive: Proton Drive CLI used for backup storage'
            'xdg-terminal-exec: Open the Proton CLI sign-in in your preferred terminal')
provides=('custos')
conflicts=('custos')
install='custos.install'
source=("$pkgname::git+$url.git"
        'custos.desktop'
        'custos.svg'
        'custos.service'
        'custos.timer'
        'LICENSE')
sha256sums=('SKIP'
            'b77424130aa0c6ee46e8e3e79bead24877bc667d542d6ab922b39e8e54779066'
            '616d6c84dd51458faa4fecf561357c33ff48d0c30054017891e1908d679890e9'
            '8f81c33865b5d8bf403a9514edf60ce08bff6b8b7f85408a101edfb2682f4dd4'
            '576443d6b96563778be6754ddcd1d356c31004b6bc43b0f9f0a821031e0c8139'
            'e1417669d8da98bc3f2ff4ad7bd24b5913326833cc91750eab4e6711a21d3a91')

pkgver() {
    cd "$srcdir/$pkgname"
    printf '0.1.r%s.g%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
    cmake -S "$srcdir/$pkgname/native" -B "$srcdir/build" \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr
    cmake --build "$srcdir/build" --target custos custos-worker
}

package() {
    install -Dm755 "$srcdir/build/custos" "$pkgdir/usr/bin/custos"
    install -Dm755 "$srcdir/build/custos-worker" "$pkgdir/usr/bin/custos-worker"
    install -Dm644 "$srcdir/custos.desktop" \
        "$pkgdir/usr/share/applications/custos.desktop"
    install -Dm644 "$srcdir/custos.svg" \
        "$pkgdir/usr/share/icons/hicolor/scalable/apps/custos.svg"
    install -Dm644 "$srcdir/custos.service" \
        "$pkgdir/usr/lib/systemd/user/custos.service"
    install -Dm644 "$srcdir/custos.timer" \
        "$pkgdir/usr/lib/systemd/user/custos.timer"
    install -Dm644 "$srcdir/LICENSE" \
        "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
