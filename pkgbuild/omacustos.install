post_install() {
    update-desktop-database -q >/dev/null 2>&1 || true
    gtk-update-icon-cache -q -t -f usr/share/icons/hicolor >/dev/null 2>&1 || true
    printf '%s\n' 'OmaCustos for Proton Drive installed. Open OmaCustos, sign in to Proton Drive, and save a backup.'
    printf '%s\n' 'Saving a daily, weekly, or monthly schedule enables scheduling automatically.'
}

post_upgrade() {
    post_install
}

post_remove() {
    update-desktop-database -q >/dev/null 2>&1 || true
    gtk-update-icon-cache -q -t -f usr/share/icons/hicolor >/dev/null 2>&1 || true
}
